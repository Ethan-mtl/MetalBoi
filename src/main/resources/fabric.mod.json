{
  "schemaVersion": 1,
  "id": "metalboi",
  "version": "${version}",
  "name": "MetalBoi",
  "description": "Reports the graphics backend Minecraft is really running on, and adds a render-scale (internal resolution) changer with a selectable upscaler. Settings appear as a MetalBoi tab in Sodium's video options when Sodium is installed.",
  "authors": [
    "Ethan-mtl"
  ],
  "contact": {
    "homepage": "https://github.com/Ethan-mtl/MetalBoi",
    "sources": "https://github.com/Ethan-mtl/MetalBoi",
    "issues": "https://github.com/Ethan-mtl/MetalBoi/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.metalboi.MetalBoiClient"
    ],
    "sodium:config_api_user": [
      "dev.metalboi.gui.MetalBoiSodiumConfig"
    ]
  },
  "mixins": [
    "metalboi.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "sodium": ">=0.8.14"
  }
}
